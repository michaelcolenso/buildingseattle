# Local tooling / one-off helper scripts
deploy_cf.py
gen_mcp_js.py

# Dependencies & environments
node_modules/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Build output (e.g. `wrangler deploy --dry-run --outdir dist`) and logs
/dist/
*.log

# OS cruft
.DS_Store
Thumbs.db

# Secrets — never commit (.dev.vars holds INGEST_API_TOKEN etc.)
.dev.vars
.env
.env.*

# Editor/agent state (local only; .claude/skills/ is tracked on purpose)
.antigravitycli/
.claude/settings.local.json
.idea/
.vscode/

# Generated SQL import artifacts (regenerate via scripts; never commit)
sql_chunk_*.sql
sql_sml_*.sql
sql_batch_*.sql
sql_big_*.sql
import.sql

# Generated data exports (regenerate via scripts; never commit)
buildingseattle_full_export.jsonl
sdci_enrichment_*.jsonl
sdci_permit_enrichments.jsonl
sdci_detail_probe_results.jsonl
sdci_detail_probe_summary.md
unenriched_permits.json
seattle_permits.jsonl
seattle_contractors.jsonl
test_batch.json
test_enrich.jsonl
/buildingseattle_permits.csv
/buildingseattle_sample.csv
buildingseattle_fresh.csv

# Base64 image blobs (the .png versions are the source of truth)
*.b64

# Gumroad build outputs (built by gumroad/build_dataset.py). The repo is
# public: the paid CSVs and ZIPs live only in gumroad/dist/ and on Gumroad.
# Only the free 100-row sample CSV is tracked.
gumroad/dist/
gumroad/releases/
gumroad/*.csv
gumroad/*.zip
!gumroad/buildingseattle_sample.csv

# Wrangler local dev state/cache (created by `wrangler dev`)
.wrangler/

# SEO monitor output (generated by scripts/check_seo_health.mjs in CI)
/seo-health-report.json
.seo-health-history.jsonl

# SEO investigation working data
scripts/seo_investigation/.seo_data/
.seo_data/

# Google OAuth client secrets / tokens (never commit)
client_secret*.json
gsc_token.json
